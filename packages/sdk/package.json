{
  "name": "@mahastrategies/sdk",
  "version": "0.3.0",
  "description": "Zero-dependency TypeScript client for the Maha Strategies API.",
  "keywords": [
    "maha",
    "api",
    "sdk",
    "mcp",
    "provenance"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build"
  }
}
