# Private reviewer endpoint and credential manager.
AGENT_REVIEW_TOKEN=

# Separate bearer token for financial and credential interventions through the
# private MPS operational control-plane API. Do not reuse AGENT_REVIEW_TOKEN.
MPS_OPERATIONS_TOKEN=

# Separate bearer token for the private Offer-to-Cash Revenue Control Plane.
# This ledger cannot send outreach, charge buyers, sign contracts, or operate wallets.
REVENUE_CONTROL_TOKEN=

# Scheduled daily qualified-inbound digest. Vercel Cron can use CRON_SECRET;
# INBOUND_DIGEST_TOKEN is an optional separate token.
INBOUND_DIGEST_TOKEN=
INBOUND_DIGEST_TO=

# Separate bearer token for the private Inbound Operations Queue UI/API.
INBOUND_OPERATIONS_TOKEN=

# Required by the private inquiry ledger. Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to run public rate-limited utilities and the Inbound Revenue
# Gatekeeper. It is only used to HMAC a visitor fingerprint; it is never sent
# to the browser. PUBLIC_UTILITY_RATE_LIMIT_SECRET may override it.
MPS_PUBLIC_AUDIT_RATE_LIMIT_SECRET=

# Optional outbound-mail overrides. RESEND_API_KEY is already required by the existing contact form.
AGENT_INQUIRY_FROM=
AGENT_INQUIRY_TO=mayone@mahastrategies.com

# MPS Preflight payment and delivery. Configure these in Vercel, never in browser code.
STRIPE_SECRET_KEY=
STRIPE_MPS_PREFLIGHT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional prepaid MPS audit-credit pack. Leave checkout disabled until you
# have created a live Stripe Price and a distinct webhook endpoint secret.
STRIPE_MPS_AUDIT_CREDIT_PRICE_ID=
MPS_AUDIT_CREDIT_PACK_UNITS=
MPS_AUDIT_CREDIT_CHECKOUT_ENABLED=false
STRIPE_MPS_CREDITS_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.mahastrategies.com
MPS_PREFLIGHT_FROM_EMAIL=

# Self-service API keys and prepaid API credit packs. Keep all non-NEXT_PUBLIC
# variables server-only. Use a distinct Stripe webhook endpoint secret when
# STRIPE_WEBHOOK_SECRET is already assigned to another product endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for the legacy v1 MCP registry. Supply either exactly 32 UTF-8
# bytes, or a 64-character hexadecimal AES-256 key. Never deploy with a
# placeholder and do not reuse this key for any other purpose.
MCP_ENCRYPTION_KEY=
# Modal dispatch and authenticated worker callback. These must be configured
# in both Vercel and the Modal secret named maha-worker-secrets.
MAHA_WORKER_URL=
MAHA_WORKER_TOKEN=
MAHA_WORKER_WEBHOOK_SECRET=
# Optional explicit public callback origin, useful when testing a preview.
MAHA_PUBLIC_ORIGIN=
# Protected-preview E2E only. Deploy `workers/maha_workers.py` with the same
# MAHA_E2E_MCP_TOKEN in Modal's maha-worker-secrets. Keep the test token
# separate from all production worker and API credentials.
TEST_API_URL=
STAGING_API_KEY=
TEST_MCP_UPSTREAM_URL=
TEST_MCP_UPSTREAM_TOKEN=
VERCEL_AUTOMATION_BYPASS_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Live Stripe Price IDs for the Developer Portal API credit packs. Keep these
# server-only; use a unique Stripe Price for each pack and environment.
STRIPE_API_CREDITS_STARTER_PRICE_ID=
STRIPE_API_CREDITS_PRO_PRICE_ID=
STRIPE_API_CREDITS_ENTERPRISE_PRICE_ID=
# Signing secret for the Stripe webhook endpoint at /api/webhooks/stripe.
# Do not reuse STRIPE_WEBHOOK_SECRET, which belongs to MPS Preflight.
STRIPE_API_KEY_WEBHOOK_SECRET=
# Tenant subscriptions and optional automatic top-up. These are server-only
# Stripe Price IDs. Auto-top-up remains disabled until a tenant explicitly
# authorizes use of a saved default payment method.
STRIPE_TENANT_BUILDER_PRICE_ID=
STRIPE_TENANT_SCALE_PRICE_ID=
STRIPE_TENANT_AUTO_TOPUP_PRICE_ID=

# Server-only credential for the non-streaming OpenAI-compatible chat proxy.
# This key is never sent to browser clients; they authenticate with Maha keys.
OPENAI_API_KEY=

# Temporary, redacted key-path diagnostics. Set to true only while debugging,
# then remove or set false. It never logs an entire Authorization header.
API_KEY_DIAGNOSTICS=false

# Book purchases (Agentic Publishing). STRIPE_BOOK_PRICE_MAP is JSON mapping
# live Stripe Price IDs to book slugs, e.g. {"price_ABC":"the-imagined-life"}.
# Use a distinct webhook endpoint secret; do not reuse other webhook secrets.
STRIPE_BOOK_PRICE_MAP=
STRIPE_BOOKS_WEBHOOK_SECRET=
BOOK_CHECKOUT_ENABLED=false
