# Agent Inquiry Gateway: leave unset to keep the endpoint disabled.
# Generate a unique token with: openssl rand -hex 32
AGENT_INQUIRY_TOKEN=

# Private reviewer endpoint. Use a different value from AGENT_INQUIRY_TOKEN.
AGENT_REVIEW_TOKEN=

# Required by the private inquiry ledger. Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional outbound-mail overrides. RESEND_API_KEY is already required by the existing contact form.
AGENT_INQUIRY_FROM=
AGENT_INQUIRY_TO=mayone@mahastrategies.com
