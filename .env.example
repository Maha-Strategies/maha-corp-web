# Private reviewer endpoint and credential manager.
AGENT_REVIEW_TOKEN=
CELESTIAL_REGISTRY_TOKEN=

# Dedicated bearer token for append-only practitioner reviews. Use at least 32
# random bytes; do not reuse the celestial registry or editorial tokens.
PRACTITIONER_REVIEW_TOKEN=

# Separate bearer token for financial and credential interventions through the
# private MPS operational control-plane API. Do not reuse AGENT_REVIEW_TOKEN.
MPS_OPERATIONS_TOKEN=

# Separate bearer token for the private Offer-to-Cash Revenue Control Plane.
# This ledger cannot send outreach, charge buyers, sign contracts, or operate wallets.
REVENUE_CONTROL_TOKEN=

# Dedicated operator token for action-bound multi-agent workflow approvals.
# Use a different value in Preview and Production and do not reuse other tokens.
WORKFLOW_CONTROL_TOKEN=

# Multi-agent orchestration packaging. Leave DEPLOYMENT_MODE unset for the
# existing internal/legacy token+tenant-header behavior. Hosted credentials are
# a JSON array of {"tenantId":"...","token":"..."}; private mode binds the
# installation to one tenant and uses WORKFLOW_CONTROL_TOKEN above.
ORCHESTRATION_DEPLOYMENT_MODE=
ORCHESTRATION_TENANT_TOKENS=
ORCHESTRATION_PRIVATE_TENANT_ID=
ORCHESTRATION_STORAGE_PROVIDER=upstash-rest
ORCHESTRATION_RETENTION_DAYS=30

# Dedicated read-only bearer token for automated billing and observability
# readiness checks. Do not reuse REVENUE_CONTROL_TOKEN.
RELEASE_HEALTH_TOKEN=

# Scheduled daily qualified-inbound digest. Vercel Cron can use CRON_SECRET;
# INBOUND_DIGEST_TOKEN is an optional separate token.
INBOUND_DIGEST_TOKEN=
INBOUND_DIGEST_TO=

# Separate bearer token for the private Inbound Operations Queue UI/API.
INBOUND_OPERATIONS_TOKEN=

# Required by the private inquiry ledger. Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production error telemetry and signed operational alerts. SENTRY_AUTH_TOKEN
# is a secret org:ci token used only at build time for source-map uploads.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
MAHA_OPS_WEBHOOK_URL=
MAHA_OPS_WEBHOOK_SECRET=
MAHA_LOW_CREDIT_ALERT_THRESHOLD=1000
MAHA_OPS_ALERT_FROM=Maha Operations <noreply@mahastrategies.com>
MAHA_OPS_ALERT_TO=mayone@mahastrategies.com

# Required to run public rate-limited utilities and the Inbound Revenue
# Gatekeeper. It is only used to HMAC a visitor fingerprint; it is never sent
# to the browser. PUBLIC_UTILITY_RATE_LIMIT_SECRET may override it.
MPS_PUBLIC_AUDIT_RATE_LIMIT_SECRET=

# Optional outbound-mail overrides. RESEND_API_KEY is already required by the existing contact form.
AGENT_INQUIRY_FROM=
AGENT_INQUIRY_TO=mayone@mahastrategies.com

# MPS Preflight payment and delivery. Configure these in Vercel, never in browser code.
STRIPE_SECRET_KEY=
STRIPE_MPS_PREFLIGHT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional prepaid MPS audit-credit pack. Leave checkout disabled until you
# have created a live Stripe Price and a distinct webhook endpoint secret.
STRIPE_MPS_AUDIT_CREDIT_PRICE_ID=
MPS_AUDIT_CREDIT_PACK_UNITS=
MPS_AUDIT_CREDIT_CHECKOUT_ENABLED=false
STRIPE_MPS_CREDITS_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.mahastrategies.com
MPS_PREFLIGHT_FROM_EMAIL=

# Self-service API keys and prepaid API credit packs. Keep all non-NEXT_PUBLIC
# variables server-only. Use a distinct Stripe webhook endpoint secret when
# STRIPE_WEBHOOK_SECRET is already assigned to another product endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAHA_REDIS_NAMESPACE=
# Required for the legacy v1 MCP registry. Supply either exactly 32 UTF-8
# bytes, or a 64-character hexadecimal AES-256 key. Never deploy with a
# placeholder and do not reuse this key for any other purpose.
MCP_ENCRYPTION_KEY=
# Required to retain Maha Celestial reports or register webhooks. Exactly 64
# hexadecimal characters (32 bytes). Keep separate from every other key.
CELESTIAL_REPORT_ENCRYPTION_KEY=
# Modal dispatch and authenticated worker callback. The token and webhook
# secret must be configured in both Vercel and the Modal secret named
# maha-worker-secrets. For callbacks to protected Preview deployments, that
# Modal secret must also contain VERCEL_AUTOMATION_BYPASS_SECRET.
MAHA_WORKER_URL=
MAHA_WORKER_TOKEN=
# Optional Modal-only credential accepted alongside MAHA_WORKER_TOKEN so
# Preview can be rotated without interrupting Production dispatch.
MAHA_WORKER_PREVIEW_TOKEN=
MAHA_WORKER_WEBHOOK_SECRET=
# Modal-only HMAC secret for callbacks to protected *.vercel.app deployments.
MAHA_WORKER_PREVIEW_WEBHOOK_SECRET=
# Optional explicit public callback origin, useful when testing a preview.
MAHA_PUBLIC_ORIGIN=
# Protected-preview E2E only. Deploy `workers/maha_workers.py` with the same
# MAHA_E2E_MCP_TOKEN in Modal's maha-worker-secrets. Keep the test token
# separate from all production worker and API credentials.
TEST_API_URL=
STAGING_API_KEY=
TEST_MCP_UPSTREAM_URL=
TEST_MCP_UPSTREAM_TOKEN=
VERCEL_AUTOMATION_BYPASS_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Live Stripe Price IDs for the Developer Portal API credit packs. Keep these
# server-only; use a unique Stripe Price for each pack and environment.
STRIPE_API_CREDITS_STARTER_PRICE_ID=
STRIPE_API_CREDITS_PRO_PRICE_ID=
STRIPE_API_CREDITS_ENTERPRISE_PRICE_ID=
# Signing secret for the Stripe webhook endpoint at /api/webhooks/stripe.
# Do not reuse STRIPE_WEBHOOK_SECRET, which belongs to MPS Preflight.
STRIPE_API_KEY_WEBHOOK_SECRET=
# Tenant subscriptions and optional automatic top-up. These are server-only
# Stripe Price IDs. Auto-top-up remains disabled until a tenant explicitly
# authorizes use of a saved default payment method.
STRIPE_TENANT_BUILDER_PRICE_ID=
STRIPE_TENANT_SCALE_PRICE_ID=
STRIPE_TENANT_AUTO_TOPUP_PRICE_ID=

# Server-only credential for the non-streaming OpenAI-compatible chat proxy.
# This key is never sent to browser clients; they authenticate with Maha keys.
OPENAI_API_KEY=

# Dedicated shared secret for the WSO2 request-phase Context Compiler
# interceptor. Insert it at the gateway as x-maha-wso2-interceptor-token;
# Maha strips that header before the rewritten request reaches the LLM.
# Use at least 32 random characters and do not reuse any API or operations key.
WSO2_CONTEXT_INTERCEPTOR_SECRET=

# Temporary, redacted key-path diagnostics. Set to true only while debugging,
# then remove or set false. It never logs an entire Authorization header.
API_KEY_DIAGNOSTICS=false

# Day-2 observability. The public DSN enables browser reporting; SENTRY_DSN may
# use the same DSN for server/edge runtimes. The auth token, org, and project
# are build-only and upload readable source maps. Sampling defaults to 0.1.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Signed operations alerts. The receiver must be a public HTTPS endpoint and
# verify X-Maha-Alert-Signature against the exact raw request body. Low-credit
# alerts deduplicate daily; MCP connectivity alerts deduplicate for 5 minutes.
MAHA_OPS_WEBHOOK_URL=
MAHA_OPS_WEBHOOK_SECRET=
MAHA_LOW_CREDIT_ALERT_THRESHOLD=1000

# Book purchases (Agentic Publishing). STRIPE_BOOK_PRICE_MAP is JSON mapping
# live Stripe Price IDs to book slugs, e.g. {"price_ABC":"the-imagined-life"}.
# Use a distinct webhook endpoint secret; do not reuse other webhook secrets.
STRIPE_BOOK_PRICE_MAP=
STRIPE_BOOKS_WEBHOOK_SECRET=
BOOK_CHECKOUT_ENABLED=false

# Paid utilities. STRIPE_UTILITY_PRICE_MAP is JSON mapping live Stripe Price
# IDs to utility slugs, e.g. {"price_ABC":"receipts-to-csv"}, and is the
# server-side binding between what was paid and which worker runs. Use a
# distinct webhook endpoint secret; do not reuse another product's.
STRIPE_UTILITY_PRICE_MAP=
STRIPE_UTILITY_WEBHOOK_SECRET=
UTILITY_CHECKOUT_ENABLED=false

# Operations paging. The Events API v2 integration key from a PagerDuty
# service. When set, verified alerts page first and email becomes the fallback
# recipient; failure and recovery alerts share a deduplication key so a
# recovery resolves the open incident rather than opening a second one.
PAGERDUTY_ROUTING_KEY=

# Machine payment over HTTP 402. Inert unless X402_ENABLED is exactly 'true';
# no other value here is read while it is off. The seller emits x402 v2 and
# CAIP-2 network identifiers even when a legacy environment alias such as
# "base" is supplied here.
X402_ENABLED=false
X402_FACILITATOR_URL=
# Required when X402_FACILITATOR_URL is Coinbase CDP. The secret remains at
# rest in the deployment environment; the server mints a request-bound JWT
# with a 120-second lifetime for each verify and settle call.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_NETWORK=eip155:8453
X402_PAY_TO=
X402_ASSET=
# Optional JSON object of static headers for non-CDP facilitators. Do not put a
# CDP bearer token here: CDP tokens expire and are bound to one request path.
X402_FACILITATOR_AUTH_HEADERS=
# JSON array. amount is the asset's smallest unit; USDC has six decimals, so
# 1000 is one tenth of a cent. concurrencyCap bounds simultaneous paid requests per
# resource, which is what protects Modal from a caller who can afford to
# saturate it. A path may only be listed here if its handler releases the
# concurrency slot -- see SLOT_RELEASING_PATHS in lib/x402/slot.ts. Pricing one
# that does not is refused at startup rather than surfacing later as 429s.
X402_RESOURCES=
# Seconds a concurrency slot is held before self-releasing. Set at or above the
# slowest expected duration for the priced resources.
X402_SLOT_TTL_SECONDS=120
# JSON-RPC endpoint used to confirm, against the chain itself, that a
# settlement the facilitator reported actually happened: the right token, from
# the payer named, to the address published in the challenge, for at least the
# price. Defaults to the public Base endpoint for the configured network.
# Unset it only to disable confirmation, which returns to taking the
# facilitator's word as final. A settlement the chain contradicts is refused
# with 502; one that cannot be read is served and recorded as unconfirmed,
# because by then the payer's funds have already moved.
X402_CHAIN_RPC_URL=

# --- Base Sepolia testnet rehearsal ------------------------------------------
# For a preview deployment rehearsal. Keep its wallet, ledger, CDP credentials,
# and facilitator configuration isolated from Production.
#
# Set on the preview deployment under test:
#   X402_ENABLED=true
#   X402_NETWORK=eip155:84532
#   X402_FACILITATOR_URL=<CDP testnet facilitator, https>
#   CDP_API_KEY_ID=<preview CDP key id>
#   CDP_API_KEY_SECRET=<preview CDP key secret>
#   X402_PAY_TO=<testnet receiving address>
#   X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#
# Optional, defaulting to USDC's domain. These are published in the challenge
# as `extra` and the facilitator uses them to rebuild the digest the payer
# signed. Wrong values produce a signature that verifies locally and is
# rejected on presentation; omitting them entirely is answered
# invalid_exact_evm_missing_eip712_domain. Read name() and version() from the
# token contract when pricing anything other than USDC.
#   X402_ASSET_EIP712_NAME=USDC
#   X402_ASSET_EIP712_VERSION=2
#
# Set to 'true' to log facilitator error bodies and stacks while debugging.
# Leave unset otherwise: it logs third-party error text on a path that has a
# payer's address in scope.
#   X402_FACILITATOR_DIAGNOSTICS=false
#   X402_RESOURCES=[{"pathPrefix":"/api/v1/compress","amount":"1000","description":"Compress long documents and RAG inputs into token-budgeted, deduplicated context packs with source-linked provenance. Call when prompt context exceeds LLM token budgets to minimize inference cost.","concurrencyCap":8}]
#
# The asset above is verified on chain as Base Sepolia USDC: 6 decimals,
# EIP-712 domain name "USDC" version "2". scripts/verify-x402-sepolia.ts reads
# those from the contract rather than trusting this comment.
#
# The variables below belong in a LOCAL shell for the verification script, not
# in Vercel. X402_TEST_PRIVATE_KEY is a throwaway testnet key that must hold
# only Base Sepolia USDC. Never put a mainnet key here, and never commit one.
X402_TEST_BASE_URL=
X402_TEST_PATH=/api/v1/compress
X402_TEST_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: a deployment with X402_ENABLED unset, to prove the flag still
# governs and no challenge headers escape.
X402_DISABLED_BASE_URL=
