{
  "name": "maha-corp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "maha": "./bin/maha.js"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run expand-graph",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "maha": "node bin/maha.js",
    "expand-graph": "node --experimental-strip-types scripts/expand-graph.ts",
    "verify:api-credit-billing": "node --experimental-strip-types scripts/verify-api-credit-billing.ts",
    "test:capacity": "node --experimental-strip-types scripts/run-capacity-test.ts",
    "verify:x402-limiter": "node --experimental-strip-types scripts/verify-x402-limiter.ts",
    "label:real-corpus": "node --experimental-strip-types scripts/label-real-corpus.ts",
    "extract:real-corpus": "node --experimental-strip-types scripts/extract-real-corpus.ts",
    "measure:arbitrage": "node --experimental-strip-types scripts/measure-arbitrage-baseline.ts",
    "measure:compression-scale": "node --experimental-strip-types scripts/measure-compression-scale.ts",
    "measure:compression": "node --experimental-strip-types scripts/measure-compression.ts",
    "recipe:context-compiler": "node --experimental-strip-types scripts/run-context-compiler-agent-recipe.ts",
    "recipe:context-compiler:live": "node --experimental-strip-types scripts/run-context-compiler-agent-recipe.ts --live",
    "recipe:bazaar-payment": "node --experimental-strip-types scripts/run-bazaar-discovery-payment-recipe.ts",
    "x402:doctor": "node --experimental-strip-types scripts/x402-doctor.ts",
    "audit:x402-trust": "node --experimental-strip-types scripts/run-x402-trust-audit.ts",
    "watch:x402": "node --experimental-strip-types scripts/run-x402-endpoint-watch.ts",
    "generate:context-playground": "node --experimental-strip-types scripts/generate-context-playground-workload.ts",
    "benchmark:context-retention": "node --experimental-strip-types scripts/run-context-retention-benchmark.ts",
    "benchmark:context-retention:publish": "node --experimental-strip-types scripts/run-context-retention-benchmark.ts --write",
    "verify:x402-sepolia": "node --experimental-strip-types scripts/verify-x402-sepolia.ts",
    "build:sdk": "npm --prefix packages/sdk run build",
    "pack:sdk": "npm --prefix packages/sdk run pack:dry-run",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@scalar/api-reference-react": "^0.9.60",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/supabase-js": "^2.112.0",
    "@upstash/redis": "^1.38.1",
    "@x402/core": "^2.21.0",
    "@x402/extensions": "^2.21.0",
    "jose": "^6.2.8",
    "katex": "^0.17.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-katex": "^3.1.0",
    "resend": "^6.18.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-katex": "^3.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "gpt-tokenizer": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "viem": "^2.55.10"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "axios": "^1.19.0",
    "nanoid@^3.0.0": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "0.35.0",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9"
  }
}
