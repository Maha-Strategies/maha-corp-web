{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mahastrategies.com/agent-inquiry-schema.json",
  "title": "Maha Strategies Agent Inquiry v0.1",
  "description": "Authenticated request to create a non-binding inquiry for human review. Do not submit confidential, regulated, or sensitive personal information.",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientRequestId", "offerId", "requester", "decision", "question", "requesterAuthorized"],
  "properties": {
    "clientRequestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "description": "Caller-generated request identifier. Repeated values receive best-effort deduplication for 24 hours on one serving instance."
    },
    "offerId": {
      "type": "string",
      "enum": ["rapid-intelligence-brief", "verified-research-brief"]
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "organization": { "type": "string", "maxLength": 200 }
      }
    },
    "decision": { "type": "string", "minLength": 12, "maxLength": 1500 },
    "question": { "type": "string", "minLength": 20, "maxLength": 5000 },
    "deadline": { "type": "string", "format": "date-time", "maxLength": 64 },
    "context": { "type": "string", "maxLength": 5000 },
    "constraints": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "requesterAuthorized": {
      "const": true,
      "description": "Attests that the requester authorized this agent to submit the inquiry."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
