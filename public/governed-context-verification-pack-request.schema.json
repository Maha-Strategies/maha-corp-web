{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mahastrategies.com/schemas/governed-context-verification-pack-request-1.0.0.json",
  "title": "Maha Governed Context Verification Pack request",
  "description": "A bounded, source-linked context compilation plus exact evidence-retention evaluation. Source text is processed transiently and is not retained in the delivery ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientRequestId", "task", "tokenBudget", "documents", "requiredEvidence"],
  "properties": {
    "clientRequestId": { "type": "string", "minLength": 8, "maxLength": 120 },
    "task": { "type": "string", "minLength": 8, "maxLength": 1200 },
    "tokenBudget": { "type": "integer", "minimum": 64, "maximum": 16000 },
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" }, "title": { "type": "string", "maxLength": 160 }, "text": { "type": "string", "minLength": 1, "maxLength": 1050000 } } }
    },
    "requiredEvidence": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "sourceId", "text"], "properties": { "evidenceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" }, "sourceId": { "type": "string" }, "text": { "type": "string", "minLength": 3, "maxLength": 4000, "description": "An exact span from the declared source document." } } }
    },
    "provenance": { "enum": ["full", "compact", "none"], "default": "full" },
    "scoring": { "enum": ["keyword", "bm25"], "default": "bm25" },
    "budgetMode": { "enum": ["estimated", "guaranteed"], "default": "guaranteed" }
  }
}
