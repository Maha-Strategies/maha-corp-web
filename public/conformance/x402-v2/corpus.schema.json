{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mahastrategies.com/conformance/x402-v2/corpus.schema.json",
  "title": "x402 v2 conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "protocolVersion",
    "license",
    "licenseUrl",
    "evaluationTime",
    "specReferences",
    "fixtures"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "corpusVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "protocolVersion": { "const": 2 },
    "license": { "const": "Apache-2.0" },
    "licenseUrl": { "type": "string", "format": "uri" },
    "evaluationTime": { "type": "integer", "minimum": 0 },
    "specReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "layer", "description", "input", "expected", "specReferences"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "layer": {
          "enum": ["http", "requirements", "eip3009", "replay", "bazaar", "settlement", "receipt"]
        },
        "description": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "phase", "code", "retry"],
          "properties": {
            "verdict": { "enum": ["accept", "reject", "warn", "indeterminate"] },
            "phase": {
              "enum": ["challenge", "requirements", "verify", "replay", "crawler", "discovery", "settle", "receipt"]
            },
            "code": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
            "retry": { "enum": ["safe", "unsafe", "after_correction", "not_applicable"] },
            "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
            "notes": { "type": "string" }
          }
        },
        "specReferences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
