# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Workspace packages install locally during pack/publish checks; those trees and
# their lockfiles are build artifacts, not sources.
/packages/*/node_modules
/packages/*/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python (Modal worker)
__pycache__/
*.py[cod]
.venv/

# next.js
/.next/
/out/

# production
/build
/packages/sdk/dist
/packages/context-control-core/dist
/packages/context-control-cli/dist
/packages/maha-mcp/dist
/packages/maha-mcp-server/dist
/packages/maha-a2a-server/dist
/packages/maha-a2a/dist

# Local counsel, strategy, and generated report artifacts. These may contain
# confidential material and do not belong in application source control.
/output/*.pdf
/output/sdk-ts-draft/
/output/migration-evidence/
/qubo-benchmark-evidence.json

# Private operator/family material. Public product documentation, reproducible
# benchmarks, and research publications belong in their explicit public trees;
# personal strategy and briefing documents do not belong in this repository.
/docs/reports/
/artifacts/*Call-Guide*.docx
/artifacts/*Call-Guide*.pdf
/artifacts/wso2/
/docs/*Family_Guide*.docx
/docs/*Family_Guide*.pdf
/scripts/create-*-call-guide.py
/scripts/create-*-family-guide.py

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps — these contain production customer and commercial data
*.sql
!supabase/migrations/*.sql
!supabase/seed.sql
interop/**/*-evidence.json
interop/**/synthetic-evidence.json

# Reproducibly generated WASM kernel artifacts. Source, compiler lockfile and
# frozen conformance vectors are tracked; binaries are built for tests/package.
/packages/wasm-kernel/dist/*.wasm
/packages/wasm-kernel/dist/*.wat
