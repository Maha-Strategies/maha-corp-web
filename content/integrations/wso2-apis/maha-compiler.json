{
  "apiVersion": "gateway.api-platform.wso2.com/v1alpha1",
  "kind": "LlmProxy",
  "metadata": {
    "name": "maha-eval-compiler"
  },
  "spec": {
    "displayName": "Maha Eval Context Compiler",
    "provider": {
      "id": "anthropic-eval"
    },
    "context": "/eval/maha",
    "version": "v1",
    "policies": [
      {
        "name": "interceptor-service",
        "version": "v1.0",
        "paths": [
          {
            "path": "/*",
            "params": {
              "requestPhase": true,
              "includeRequestBody": true,
              "includeRequestHeaders": true,
              "endpointFromEnv": "MAHA_INTERCEPTOR_ENDPOINT",
              "credentialHeader": "x-maha-wso2-interceptor-token",
              "credentialFromEnv": "WSO2_CONTEXT_INTERCEPTOR_SECRET",
              "failClosed": true
            }
          }
        ]
      }
    ]
  }
}
