{
  "apiVersion": "gateway.api-platform.wso2.com/v1alpha1",
  "kind": "LlmProxy",
  "metadata": {
    "name": "maha-eval-compiler"
  },
  "spec": {
    "displayName": "Maha Eval Context Compiler",
    "provider": {
      "id": "anthropic-eval"
    },
    "context": "/eval/maha",
    "version": "v1",
    "policies": [
      {
        "name": "set-headers",
        "version": "v1.0.1",
        "paths": [
          {
            "path": "/*",
            "params": {
              "request": {
                "headers": [
                  {
                    "name": "x-maha-wso2-interceptor-token",
                    "valueFromEnv": "WSO2_CONTEXT_INTERCEPTOR_SECRET"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "name": "interceptor-service",
        "version": "v1.0.0",
        "paths": [
          {
            "path": "/*",
            "params": {
              "endpointFromEnv": "MAHA_INTERCEPTOR_BASE",
              "request": {
                "includeRequestHeaders": true,
                "includeRequestBody": true,
                "passthroughOnError": false
              },
              "timeoutMillis": 20000
            }
          }
        ]
      }
    ]
  }
}
