{
  "apiVersion": "gateway.api-platform.wso2.com/v1alpha1",
  "kind": "LlmProxy",
  "metadata": {
    "name": "maha-eval-native"
  },
  "spec": {
    "displayName": "Maha Eval Native Compressor",
    "provider": {
      "id": "anthropic-eval"
    },
    "context": "/eval/native",
    "version": "v1",
    "policies": [
      {
        "name": "prompt-compressor",
        "version": "v0.9.0",
        "paths": [
          {
            "path": "/*",
            "params": {
              "jsonPath": "$.messages[0].content",
              "rules": [
                {
                  "upperTokenLimit": -1,
                  "type": "ratio",
                  "value": 0.55
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
